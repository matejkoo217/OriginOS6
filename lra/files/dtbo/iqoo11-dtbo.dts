/dts-v1/;

/ {
	qcom,pmic-id = <0x2f 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
	qcom,pmic-id-size = <0x08>;
	model = "Qualcomm Technologies, Inc. Kalama QRD PD2243";
	compatible = "qcom,kalama-qrd\0qcom,kalama\0qcom,qrd";
	qcom,msm-id = <0x207 0x10000 0x218 0x10000>;
	qcom,board-id = <0x1000b 0x01>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8550@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pm8550-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x01 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x01 0x103>;
					io-channel-names = "thermal";
					phandle = <0x05>;
				};

				pinctrl@8800 {
					compatible = "qcom,pm8550-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x35>;

					key_vol_up {

						key_vol_up_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x34>;
						};
					};

					sd_card_det {

						sd_card_det_default {
							function = "normal";
							input-enable;
							output-disable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x33>;
						};
					};

					usb_conn_pro {

						usb_conn_pro_default {
							pins = "gpio9";
							function = "normal";
							power-source = <0x00>;
							output-low;
							phandle = <0x49>;
						};
					};

					pm8550_gpio12_adc {

						pm8550_gpio12_adc_default {
							pins = "gpio12";
							bias-high-impedance;
							phandle = <0x17>;
						};
					};

					sim1_card_detect {

						sim1_card_detect_default {
							pins = "gpio8";
							function = "normal";
							input-enable;
							output-disable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x53>;
						};
					};

					sim2_card_detect {

						sim2_card_detect_default {
							pins = "gpio10";
							function = "normal";
							input-enable;
							output-disable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x54>;
						};
					};
				};

				pwms@e800 {
					compatible = "qcom,pwm-lpg";
					reg = <0xe800>;
					reg-names = "lpg-base";
					#pwm-cells = <0x02>;
					qcom,num-lpg-channels = <0x03>;
					nvmem = <0x02 0x03>;
					nvmem-names = "lpg_chan_sdam\0lut_sdam";
					qcom,lut-sdam-base = <0x45>;
					qcom,lut-patterns = <0x00 0x0a 0x14 0x1e 0x28 0x32 0x3c 0x46 0x50 0x5a 0x64 0x5a 0x50 0x46 0x3c 0x32 0x28 0x1e 0x14 0x0a 0x00>;
					qcom,tick-duration-us = <0x1e78>;
					phandle = <0x04>;

					lpg@1 {
						qcom,lpg-chan-id = <0x01>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x13>;
						qcom,ramp-pattern-repeat;
						qcom,lpg-sdam-base = <0x48>;
					};

					lpg@2 {
						qcom,lpg-chan-id = <0x02>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x13>;
						qcom,ramp-pattern-repeat;
						qcom,lpg-sdam-base = <0x56>;
					};

					lpg@3 {
						qcom,lpg-chan-id = <0x03>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x13>;
						qcom,ramp-pattern-repeat;
						qcom,lpg-sdam-base = <0x64>;
					};
				};

				pwms@eb00 {
					compatible = "qcom,pwm-lpg";
					reg = <0xeb00>;
					reg-names = "lpg-base";
					#pwm-cells = <0x02>;
					qcom,num-lpg-channels = <0x01>;
					phandle = <0x55>;
				};

				qcom,leds@ef00 {
					compatible = "qcom,tri-led";
					reg = <0xef00>;
					phandle = <0x56>;

					red {
						label = "red";
						pwms = <0x04 0x00 0xf4240>;
						led-sources = <0x00>;
						linux,default-trigger = "timer";
					};

					green {
						label = "green";
						pwms = <0x04 0x01 0xf4240>;
						led-sources = <0x01>;
						linux,default-trigger = "timer";
					};

					blue {
						label = "blue";
						pwms = <0x04 0x02 0xf4240>;
						led-sources = <0x02>;
						linux,default-trigger = "timer";
					};
				};

				bcl@4700 {
					compatible = "qcom,bcl-v5";
					reg = <0x4700 0x100>;
					interrupts = <0x01 0x47 0x00 0x00 0x01 0x47 0x01 0x00 0x01 0x47 0x02 0x00>;
					interrupt-names = "bcl-lvl0\0bcl-lvl1\0bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					phandle = <0x06>;
				};

				qcom,flash_led@ee00 {
					compatible = "qcom,pm8350c-flash-led";
					reg = <0xee00>;
					interrupts = <0x01 0xee 0x00 0x01 0x01 0xee 0x03 0x01 0x01 0xee 0x04 0x01>;
					interrupt-names = "led-fault-irq\0all-ramp-down-done-irq\0all-ramp-up-done-irq";
					qcom,thermal-derate-current = <0xc8 0x1f4>;
					status = "ok";
					phandle = <0x57>;

					qcom,flash_0 {
						status = "ok";
						qcom,current-ma = <0x320>;
						label = "flash";
						qcom,led-name = "led:flash_0";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash0_trigger";
						qcom,id = <0x00>;
						qcom,duration-ms = <0x136>;
						qcom,ires-ua = <0x1388>;
						phandle = <0x58>;
					};

					qcom,flash_1 {
						status = "ok";
						qcom,current-ma = <0x320>;
						label = "flash";
						qcom,led-name = "led:flash_1";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash1_trigger";
						qcom,id = <0x01>;
						qcom,duration-ms = <0x136>;
						qcom,ires-ua = <0x1388>;
						phandle = <0x59>;
					};

					qcom,flash_2 {
						status = "ok";
						qcom,current-ma = <0x320>;
						label = "flash";
						qcom,led-name = "led:flash_2";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash2_trigger";
						qcom,id = <0x02>;
						qcom,duration-ms = <0x136>;
						qcom,ires-ua = <0x1388>;
						phandle = <0x5a>;
					};

					qcom,flash_3 {
						status = "ok";
						qcom,current-ma = <0x320>;
						label = "flash";
						qcom,led-name = "led:flash_3";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash3_trigger";
						qcom,id = <0x03>;
						qcom,duration-ms = <0x136>;
						qcom,ires-ua = <0x1388>;
						phandle = <0x5b>;
					};

					qcom,torch_0 {
						status = "ok";
						qcom,current-ma = <0x64>;
						label = "torch";
						qcom,led-name = "led:torch_0";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch0_trigger";
						qcom,id = <0x00>;
						qcom,ires-ua = <0x1388>;
						phandle = <0x5c>;
					};

					qcom,torch_1 {
						status = "ok";
						qcom,current-ma = <0x64>;
						label = "torch";
						qcom,led-name = "led:torch_1";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch1_trigger";
						qcom,id = <0x01>;
						qcom,ires-ua = <0x1388>;
						phandle = <0x5d>;
					};

					qcom,torch_2 {
						status = "ok";
						qcom,current-ma = <0x41>;
						label = "torch";
						qcom,led-name = "led:torch_2";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch2_trigger";
						qcom,id = <0x02>;
						qcom,ires-ua = <0x1388>;
						phandle = <0x5e>;
					};

					qcom,torch_3 {
						status = "ok";
						qcom,current-ma = <0x41>;
						label = "torch";
						qcom,led-name = "led:torch_3";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch3_trigger";
						qcom,id = <0x03>;
						qcom,ires-ua = <0x1388>;
						phandle = <0x5f>;
					};

					qcom,led_switch_0 {
						label = "switch";
						qcom,led-name = "led:switch_0";
						qcom,default-led-trigger = "switch0_trigger";
						qcom,led-mask = <0x06>;
						qcom,symmetry-en;
						phandle = <0x60>;
					};

					qcom,led_switch_1 {
						label = "switch";
						qcom,led-name = "led:switch_1";
						qcom,default-led-trigger = "switch1_trigger";
						qcom,led-mask = <0x06>;
						qcom,symmetry-en;
						phandle = <0x61>;
					};

					qcom,led_switch_2 {
						label = "switch";
						qcom,led-name = "led:switch_2";
						qcom,default-led-trigger = "switch2_trigger";
						qcom,led-mask = <0x06>;
						qcom,symmetry-en;
						phandle = <0x62>;
					};
				};
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {

			pm8550_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x05>;
				phandle = <0x63>;

				trips {

					trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x64>;
					};

					trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x65>;
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0x66>;
					};
				};
			};

			pm8550-bcl-lvl0 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x06 0x05>;

				trips {

					bcl-lvl0 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x27>;
					};
				};
			};

			pm8550-bcl-lvl1 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x06 0x06>;

				trips {

					bcl-lvl1 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x28>;
					};
				};
			};

			pm8550-bcl-lvl2 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x06 0x07>;

				trips {

					bcl-lvl2 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x29>;
					};
				};
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8550b@7 {
				compatible = "qcom,spmi-pmic";
				reg = <0x07 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pm8550b-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x07 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x01 0x703>;
					io-channel-names = "thermal";
					phandle = <0x0d>;
				};

				pm8550b-temp-alarm-lite@c00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xc00>;
					interrupts = <0x07 0x0c 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x01 0x718>;
					io-channel-names = "thermal";
					phandle = <0x0e>;
				};

				pinctrl@8800 {
					compatible = "qcom,pm8550b-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x08>;

					pm8550b_gpio5_adc {

						pm8550b_gpio5_adc_default {
							pins = "gpio5";
							bias-high-impedance;
							phandle = <0x18>;
						};
					};

					pm8550b_gpio6_adc {

						pm8550b_gpio6_adc_default {
							pins = "gpio6";
							bias-high-impedance;
							phandle = <0x19>;
						};
					};

					trigger_gpio {

						trigger_gpio_default {
							pins = "gpio11";
							function = "normal";
							bias-pull-up;
							qcom,pull-up-strength = <0x02>;
							power-source = <0x00>;
							input-enable;
							phandle = <0x09>;
						};
					};
				};

				qcom,hv-haptics@f000 {
					compatible = "qcom,hv-haptics";
					reg = <0xf000 0xf100 0xf200>;
					interrupts = <0x07 0xf0 0x01 0x01>;
					interrupt-names = "fifo-empty";
					qcom,vmax-mv = <0x4f6>;
					qcom,brake-mode = <0x01>;
					qcom,brake-pattern = [ff 3f 1f];
					qcom,lra-period-us = <0x16fa>;
					qcom,drv-sig-shape = <0x01>;
					qcom,brake-sig-shape = <0x01>;
					status = "ok";
					nvmem-names = "hap_cfg_sdam";
					nvmem = <0x07>;
					interrupt-parent = <0xffffffff>;
					irq-gpio = <0x08 0x0b 0x00>;
					pinctrl-names = "default";
					pinctrl-0 = <0x09>;
					qcom,brake-disable;
					qcom,rt-imp-detect;
					resistance_min = <0x1388>;
					resistance_max = <0x4e20>;
					freq_min = <0x5dc>;
					freq_max = <0x76c>;
					lra_info = <0x257b>;
					richtap_type = <0x01>;
					ram_effects = <0x0a>;
					rtp_effects = <0x0b>;
					scene_array = <0x0c>;
					vib_num = <0x02>;
					phandle = <0x67>;

					qcom,hap-swr-slave-reg {
						regulator-name = "hap-swr-slave-reg";
						phandle = <0x68>;
					};

					effect_0 {
						qcom,wf-vmax-mv = <0x708>;
						qcom,wf-pattern-period-us = <0x16f8>;
					};

					effect_1 {
						qcom,wf-vmax-mv = <0x708>;
						qcom,wf-pattern-period-us = <0x16f8>;
					};

					effect_2 {
						qcom,wf-vmax-mv = <0x708>;
						qcom,wf-pattern-period-us = <0x16f8>;
					};

					effect_3 {
						qcom,wf-vmax-mv = <0x708>;
						qcom,wf-pattern-period-us = <0x16f8>;
					};

					effect_4 {
						qcom,wf-vmax-mv = <0x708>;
						qcom,wf-pattern-period-us = <0x16f8>;
					};

					effect_5 {
						qcom,wf-vmax-mv = <0x708>;
						qcom,wf-pattern-period-us = <0x16f8>;
					};
				};

				bcl@4700 {
					compatible = "qcom,bcl-v5";
					reg = <0x4700 0x100>;
					interrupts = <0x07 0x47 0x00 0x00 0x07 0x47 0x01 0x00 0x07 0x47 0x02 0x00>;
					interrupt-names = "bcl-lvl0\0bcl-lvl1\0bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					phandle = <0x0f>;
				};

				bcl-soc {
					compatible = "qcom,msm-bcl-soc";
					#thermal-sensor-cells = <0x00>;
					phandle = <0x10>;
				};

				qcom,eusb2-repeater@fd00 {
					compatible = "qcom,pmic-eusb2-repeater";
					reg = <0xfd00>;
					vdd18-supply = <0xffffffff>;
					vdd3-supply = <0xffffffff>;
					qcom,param-override-seq = <0x00 0x50 0x0e 0x51 0x03 0x52 0x01 0x53 0x04 0x54 0x03 0x55 0x00 0x56 0x07 0x57 0x02 0x58 0x03 0x59 0x01 0x5a 0x02 0x5b>;
					qcom,param-override-seq-host = <0x00 0x50 0x08 0x51 0x01 0x52 0x07 0x53 0x04 0x54 0x00 0x55 0x00 0x56 0x04 0x57 0x02 0x58 0x03 0x59 0x01 0x5a 0x02 0x5b>;
					phandle = <0x37>;
				};
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {

			pm8550b_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x0d>;
				phandle = <0x69>;

				trips {

					trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x6a>;
					};

					trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x6b>;
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
						phandle = <0x6c>;
					};
				};
			};

			pm8550b_lite_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x0e>;
				phandle = <0x6d>;

				trips {

					trip0 {
						temperature = <0x1e848>;
						hysteresis = <0x00>;
						type = "passive";
					};

					trip1 {
						temperature = <0x20f58>;
						hysteresis = <0x00>;
						type = "passive";
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "critical";
					};
				};
			};

			pm8550b-ibat-lvl0 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <0x0f 0x00>;

				trips {

					ibat-lvl0 {
						temperature = <0x2710>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0x6e>;
					};
				};
			};

			pm8550b-ibat-lvl1 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <0x0f 0x01>;

				trips {

					ibat-lvl1 {
						temperature = <0x2cec>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0x6f>;
					};
				};
			};

			pm8550b-bcl-lvl0 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-sensors = <0x0f 0x05>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					b-bcl-lvl0 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x24>;
					};
				};
			};

			pm8550b-bcl-lvl1 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-sensors = <0x0f 0x06>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
