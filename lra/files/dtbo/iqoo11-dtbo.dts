	fragment@45 {
		target = <0xffffffff>;

		__overlay__ {

			qupv3_se8_spi_pins {
				phandle = <0xa9>;

				qupv3_se8_spi_miso_active {
					phandle = <0x4c>;

					mux {
						pins = "gpio56";
						function = "qup2_se0_l0_mira";
					};

					config {
						pins = "gpio56";
						drive-strength = <0x06>;
						bias-disable;
					};
				};

				qupv3_se8_spi_mosi_active {
					phandle = <0x4b>;

					mux {
						pins = "gpio57";
						function = "qup2_se0_l1_mira";
					};

					config {
						pins = "gpio57";
						drive-strength = <0x06>;
						bias-disable;
					};
				};

				qupv3_se8_spi_clk_active {
					phandle = <0x4d>;

					mux {
						pins = "gpio109";
						function = "qup2_se0_l2_mirb";
					};

					config {
						pins = "gpio109";
						drive-strength = <0x06>;
						bias-disable;
					};
				};

				qupv3_se8_spi_cs_active {
					phandle = <0x4e>;

					mux {
						pins = "gpio107";
						function = "qup2_se0_l3_mirb";
					};

					config {
						pins = "gpio107";
						drive-strength = <0x06>;
						bias-disable;
					};
				};

				qupv3_se8_spi_sleep {
					phandle = <0x4f>;

					mux {
						pins = "gpio56\0gpio57\0gpio109\0gpio107";
						function = "gpio";
					};

					config {
						pins = "gpio56\0gpio57\0gpio109\0gpio107";
						drive-strength = <0x06>;
						bias-disable;
					};
				};
			};
		};
	};

	fragment@46 {
		target = <0xffffffff>;

		__overlay__ {

			qcom,qupv3_2_geni_se@8c0000 {
				compatible = "qcom,geni-se-qup";
				reg = <0x8c0000 0x2000>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				status = "ok";
				phandle = <0x3a>;

				spi@880000 {
					compatible = "qcom,spi-geni";
					reg = <0x880000 0x4000>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					pinctrl-names = "default\0sleep";
					pinctrl-0 = <0x4b 0x4c 0x4d 0x4e>;
					pinctrl-1 = <0x4f>;
					status = "ok";
					phandle = <0xaa>;

					irled_spi_38k@01 {
						status = "ok";
						compatible = "qcom_irled_spi";
						reg = <0x00>;
						spi-max-frequency = <0x1e8480>;
					};
				};
			};
		};
	};

