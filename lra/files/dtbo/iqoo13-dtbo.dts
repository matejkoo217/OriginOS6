						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x31>;
					};
				};
			};
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8550ve@3 {
				compatible = "qcom,spmi-pmic";
				reg = <0x03 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "ok";
				phandle = <0x74>;

				pm8550ve-d-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x03 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x03 0x303>;
					io-channel-names = "thermal";
					phandle = <0x08>;
				};

				pinctrl@8800 {
					compatible = "qcom,pm8550ve-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x75>;
				};
			};

			qcom,pm8550ve@5 {
				compatible = "qcom,spmi-pmic";
				reg = <0x05 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "ok";
				phandle = <0x76>;

				pm8550ve-f-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x05 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x03 0x503>;
					io-channel-names = "thermal";
					phandle = <0x09>;
				};

				pinctrl@8800 {
					compatible = "qcom,pm8550ve-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x77>;

					bt_uwb_en {
						phandle = <0x165>;
						power-source = <0x01>;
						bias-disable;
						output-enable;
						input-disable;
						function = "normal";
						pins = "gpio3";
					};

					bt_fmd_clk_en {
						phandle = <0x167>;
						power-source = <0x01>;
						bias-disable;
						output-disable;
						input-enable;
						function = "normal";
						pins = "gpio6";
					};
				};
			};

			qcom,pm8550ve@6 {
				compatible = "qcom,spmi-pmic";
				reg = <0x06 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "ok";
				phandle = <0x78>;

				pm8550ve-g-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x06 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x03 0x603>;
					io-channel-names = "thermal";
					phandle = <0x0a>;
				};

				pinctrl@8800 {
					compatible = "qcom,pm8550ve-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x79>;
				};
			};

			qcom,pm8550ve@8 {
				compatible = "qcom,spmi-pmic";
				reg = <0x08 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "ok";
				phandle = <0x7a>;

				pm8550ve-i-temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x08 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <0x03 0x803>;
					io-channel-names = "thermal";
					phandle = <0x0b>;
				};

				pinctrl@8800 {
					compatible = "qcom,pm8550ve-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x7b>;
				};
			};
		};
	};

