	fragment@69 {
		target = <0xffffffff>;

		__overlay__ {

			vfcs_int_gpio {

				vfcs_int_gpio_default {
					phandle = <0x59>;

					mux {
						pins = "gpio65";
						function = "gpio";
					};

					config {
						pins = "gpio65";
						drive-strength = <0x02>;
						bias-disable;
						input-enable;
					};
				};
			};

			sc8577_int_gpio {

				sc8577_int_gpio_default {
					phandle = <0x58>;

					mux {
						pins = "gpio85";
						function = "gpio";
					};

					config {
						pins = "gpio85";
						drive-strength = <0x02>;
						bias-disable;
						input-enable;
					};
				};
			};

			sm1396_m_en_gpio {

				sm1396_m_en_gpio_default {
					phandle = <0x56>;

					mux {
						pins = "gpio95";
						function = "gpio";
					};

					config {
						pins = "gpio95";
						drive-strength = <0x02>;
						output-low;
						bias-pull-down;
					};
				};
			};

			sm1396_s_en_gpio {

				sm1396_s_en_gpio_default {
					phandle = <0x57>;

					mux {
						pins = "gpio97";
						function = "gpio";
					};

					config {
						pins = "gpio97";
						drive-strength = <0x02>;
						output-low;
						bias-pull-down;
					};
				};
			};
		};
	};

