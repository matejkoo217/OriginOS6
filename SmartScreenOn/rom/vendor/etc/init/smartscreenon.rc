# SmartScreenOn — camera-id remap for vivo's "Keep screen on while viewing".
#
# com.bbk.facewake's FaceWakeService hardcodes vivo's front-camera id "1"
# (vivo numbering: 0 = rear wide, 1 = front wide).  On fuxi the QTI camera
# provider exposes the front camera as "0" and "1" is the rear main camera, so
# the gaze detector stares at the back of the phone, never sees a face and
# never calls PowerManager.userActivity() — the screen still times out.
#
# smartscreenond injects libsmartscreenon.so (LSPlant) into that process and
# rewrites CameraManager.openCamera() to the device's real LENS_FACING_FRONT
# camera id.
#
# Binary + rc live in /vendor; the payload libs live in a private
# /vendor/framework/smartscreenon subdir (system_file) and are loaded by fd, so
# they never enter the app's global namespace and cannot shadow platform libs.
service smartscreenond /vendor/bin/smartscreenond com.bbk.facewake /vendor/framework/smartscreenon/libc++_shared.so /vendor/framework/smartscreenon/libdobby.so /vendor/framework/smartscreenon/liblsplant.so /vendor/framework/smartscreenon/libsmartscreenon.so
    class late_start
    user root
    group root system
    # Reuses the existing abouthookd domain (same job: LSPlant injector that
    # ptrace()s a system_app process); no sepolicy rebuild needed.
    seclabel u:r:abouthookd:s0
    # not oneshot: FaceWakeService is started/stopped on every screen-on cycle
    # and the process is reaped under memory pressure, so the injector has to
    # stay alive and re-hook each new pid.
